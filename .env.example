# Keep actual credentials in ignored .env, never in source control.
DB_URL=jdbc:postgresql://localhost:5433/contextiq
DB_USERNAME=
DB_PASSWORD=
DB_PORT=
FRONTEND_URL=
GOOGLE_LOGIN_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false for localhost HTTP; true for HTTPS deployments
SESSION_COOKIE_SECURE=

# Local Spring AI / Ollama chat (no API key)
AI_MODE=
OLLAMA_MODEL=
OLLAMA_BASE_URL=
OLLAMA_DOCKER_BASE_URL=
OLLAMA_MAX_OUTPUT_TOKENS=
OLLAMA_CONTEXT_SIZE=

# Phase 3: keep this embedding model fixed while documents are indexed.
OLLAMA_EMBEDDING_MODEL=
RAG_MIN_SCORE=

# Optional invitation email (JavaMailSender). Fill these in your ignored .env.
# Leave disabled until your SMTP provider is configured. In-app invites work without email.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_SSL_ENABLED=false
INVITATION_TTL_DAYS=7
